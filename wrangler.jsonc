{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-forger",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idea-forge-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "INBOX_LIMIT": "20",
    "TZ_OFFSET_HOURS": "7",
  },
  // Workers AI: luôn gọi từ xa kể cả `npm run dev` (cần `wrangler login`). Thiếu binding thì app vẫn chạy, chỉ tắt tính năng AI.
  "ai": { "binding": "AI" },
  // Embedding lưu ở D1 (note_embeddings). Chuyển sang "vectorize": [...] khi vượt vài nghìn note.
}
