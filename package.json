{
  "name": "idea-forge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "node scripts/check-deploy-config.mjs --migrate",
    "deploy": "npm run build:production && npm run deploy:ci",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "deploy:ci": "npm run db:migrate:remote && node scripts/check-deploy-config.mjs --deploy",
    "build:production": "npm run typecheck && vite build --mode deploy",
    "deploy:check": "node scripts/check-deploy-config.mjs",
    "test": "node --test test/*.test.mjs",
    "forge": "node scripts/forge.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
